# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_SECONDARY: Optional first fallback Gemini API Key if primary rate limits (429) or fails.
GEMINI_API_KEY_SECONDARY=""

# GEMINI_API_KEY_TERTIARY: Optional second fallback Gemini API Key if secondary rate limits (429) or fails.
GEMINI_API_KEY_TERTIARY=""

# GROQ_API_KEY: Optional. Used if you want to use Groq Llama-3 parsing instead of Google Gemini.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGS (Critical for Render/Production environments where local files wipe)
# GOOGLE_APPLICATION_CREDENTIALS_JSON: The full raw contents of your downloaded Firebase Service Account Private Key JSON file.
GOOGLE_APPLICATION_CREDENTIALS_JSON=""

# FIREBASE_PROJECT_ID: Your Firebase project ID (e.g. innate-pursuit-8r5vm).
FIREBASE_PROJECT_ID=""

# FIREBASE_DATABASE_ID: Optional specific Firestore custom Database ID (e.g. ai-studio-xxxxxxxx) if not using default.
FIREBASE_DATABASE_ID=""

# PAYMENT_WEBHOOK_SECRET: Secret authorization token for automated Google Sheets / PhonePe webhook.
# Set a custom securely-generated token here and on Google Apps Script to verify authentic calls.
PAYMENT_WEBHOOK_SECRET="sheet_to_render_secret_token_12345"

# RAZORPAY API CREDENTIALS
# Configure your Razorpay Key ID and Secret from the Razorpay Dashboard (https://dashboard.razorpay.com).
# If left blank, the app will run in signature-verified Sandbox Mode for local development testing.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""


